# Normalize text files
* text=auto

# Always use LF for source code
*.ino text eol=lf
*.c   text eol=lf
*.h   text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf

# Use LF for common text files
*.md   text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Keep Windows batch files as CRLF
*.bat text eol=crlf
*.cmd text eol=crlf